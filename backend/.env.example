# Database
DATABASE_URL=postgresql://user:password@localhost:5432/campus_marketplace
# Or use DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, and DB_NAME instead.

# Runtime
PORT=5000
NODE_ENV=development
DB_SSL=false
# DB_SSL_CA=PEM-encoded-CA-certificate-for-production
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SAME_SITE=lax

# Email verification
SENDGRID_API_KEY=replace-with-sendgrid-api-key
EMAIL_FROM=verified-sender@example.com

# Image hosting
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
